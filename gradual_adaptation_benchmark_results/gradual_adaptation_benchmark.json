{
  "config": {
    "method": "Gradual Chromatic Adaptation (GCA): slow white-point shift along a yellow-green u'v' trajectory from D65 (Bradford CAT), exploiting slow human chromatic adaptation to be perceptually invisible. Plus GUD (gradual uniform dimming). Velocity is adaptation-bounded: the perceived cast |A-a| stays within 5 JND while the absolute illuminant drift exceeds DELTA_T.",
    "benchmark_metric": "screen (OLED) display power: saving = 1 - power(opt)/power(orig), power = sum(R*0.229 + G*0.243 + B*0.526)",
    "trajectory": "1.47",
    "velocity_upvp_per_sec": 0.000419,
    "time_sec": 120.0,
    "t_max_sec": 120.0,
    "gud_enabled": true,
    "gud_target": 0.85,
    "power_weights_rgb": [
      0.229,
      0.243,
      0.526
    ],
    "max_metam_side": 768,
    "max_images_per_dataset": 10,
    "temporal_averaging": {
      "method": "frame skipping: dataset image k of N rendered at t_k = (k+0.5)/N * time_s across the gradual ramp; per-image saving ramps 0 -> max, dataset mean estimates the time-averaged ramp saving",
      "n_time_samples": 10,
      "note": "All metrics (Saving%, PSNR, SSIM, MetaM) computed per image on its own time-stamp state (no shared worst-case state); dataset avg = ramp average"
    }
  },
